# Ultramsg
ULTRAMSG_INSTANCE_ID=instanceXXXX
ULTRAMSG_TOKEN=your_ultramsg_token

# OpenAI (or compatible)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Database (SQLite for local, Postgres on Render)
DATABASE_URL=sqlite+aiosqlite:///./smart_assistant.db
# DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname

# Security for dashboard
DASHBOARD_SECRET=change-this-to-a-strong-secret
ADMIN_PASSWORD=admin123

# Meta Ads (optional)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_XXXXXXXX
META_APP_ID=
META_APP_SECRET=

# App
APP_URL=https://your-app.onrender.com
COMPANY_NAME=Smart Assistant
